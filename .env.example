# PromoLens local analysis API - copy this file to apps/api/.env and edit as needed.
# The real .env file is ignored by Git. Never put provider keys in the extension.

# Port the local API listens on.
PORT=8787

# Comma-separated list of allowed browser origins for CORS.
# "chrome-extension://*" allows any locally loaded extension (fine for development).
# To restrict to your own extension, replace the wildcard with its ID,
# e.g. chrome-extension://abcdefghijklmnopabcdefghijklmnop
ALLOWED_ORIGINS=chrome-extension://*,http://localhost:5173,http://127.0.0.1:5173

# Basic per-client rate limit (requests per minute).
RATE_LIMIT_PER_MINUTE=60

# Maximum accepted request body size in bytes.
MAX_BODY_BYTES=262144

# Milliseconds before an analysis request is abandoned.
REQUEST_TIMEOUT_MS=50000

# How long (hours) a result is kept in the server-side hash cache.
CACHE_TTL_HOURS=24

# Analysis provider:
#   mock   - deterministic rule engine on the server, no key needed (default)
#   openai - an OpenAI-compatible chat model used as an evidence witness
#            (it reports quoted evidence; the rule engine still computes the score)
#   openai-direct - EXPERIMENTAL: the model produces the score itself. Only for
#            comparing approaches with `npm run eval`; see docs/evaluation.md.
ANALYSIS_PROVIDER=mock

# Provider secret. Leave empty for the mock provider. NEVER commit a real value.
# Paste it here by hand - do not send keys through chat tools or tickets.
ANALYSIS_PROVIDER_API_KEY=

# Model id as listed in your provider dashboard (required for openai).
LLM_MODEL=

# Base URL of the OpenAI-compatible API. Change only for a proxy or another vendor.
LLM_BASE_URL=https://api.openai.com/v1

# Milliseconds allowed for one model call (kept below REQUEST_TIMEOUT_MS).
LLM_TIMEOUT_MS=45000

# Reasoning models (GPT-5 family, o-series) think before answering; PromoLens
# only needs evidence extraction, so "low" is fast and accurate enough.
# Defaults to "low" for those model ids, unset for others. minimal|low|medium|high|none
LLM_REASONING_EFFORT=low

# GPT-5 family answer length. Defaults to "low" for gpt-5 ids. low|medium|high|none
LLM_VERBOSITY=low

# Set to "true" only while debugging locally. Default keeps raw post text out of logs.
LOG_RAW_CONTENT=false
