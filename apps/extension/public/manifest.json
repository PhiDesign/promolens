{
  "manifest_version": 3,
  "name": "PromoLens",
  "version": "0.2.0",
  "description": "Estimates how likely Reddit posts are to be promotional, showing observable evidence and uncertainty. Not affiliated with Reddit.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": ["https://www.reddit.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.reddit.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PromoLens",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
